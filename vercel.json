{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/ping",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/analyze",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/build",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/assist",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
